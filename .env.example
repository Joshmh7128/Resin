# Local development: run `docker compose up -d` to start a local Postgres,
# then use these connection strings as-is. There's no pooler in front of the
# local database, so both point at the same place.
DATABASE_URL="postgresql://postgres:devpassword@localhost:5433/resin"
DATABASE_URL_UNPOOLED="postgresql://postgres:devpassword@localhost:5433/resin"

# Production (Render + Neon): use the connection strings from your Neon project
# dashboard. Both are required, and they are different:
#   DATABASE_URL          the "pooled" string (hostname contains -pooler),
#                         used by the app for its normal queries.
#   DATABASE_URL_UNPOOLED the direct string (no -pooler), used only for
#                         migrations. Migrations take a session-level advisory
#                         lock, which the pooler cannot hold, so running them
#                         through it fails with a lock timeout.
# DATABASE_URL="postgresql://<user>:<password>@<host>-pooler/<db>?sslmode=require"
# DATABASE_URL_UNPOOLED="postgresql://<user>:<password>@<host>/<db>?sslmode=require"

# Generate a real one with: openssl rand -base64 32
SESSION_SECRET="replace-me-with-a-real-random-secret"

# Optional. Absolute base URL used when generating the storefront QR code.
# Required in production; inferred from the request's Host header in dev.
# NEXT_PUBLIC_BASE_URL="https://your-domain.com"

# Discogs application credentials, from https://www.discogs.com/settings/developers
# Reading public data only needs the consumer key/secret — no per-user OAuth flow.
# Supplying them raises the API ceiling from 25 to 60 requests/minute, which
# roughly halves how long it takes to fill in a store's cover art.
# The limit is per source IP, so these apply to the whole app, not per store.
DISCOGS_CONSUMER_KEY=""
DISCOGS_CONSUMER_SECRET=""
