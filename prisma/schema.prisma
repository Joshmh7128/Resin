generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Pooled connection, used by the app at runtime.
  url       = env("DATABASE_URL")
  // Direct connection, used for migrations only.
  //
  // Migrations take a session-level Postgres advisory lock, and Neon's pooled
  // endpoint (PgBouncer, transaction mode) doesn't hold session state between
  // statements, so acquiring that lock through it times out. Locally both point
  // at the same database, since there is no pooler in front of it.
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Store {
  id               String   @id @default(cuid())
  slug             String   @unique
  name             String
  email            String   @unique
  passwordHash     String
  discogsUsername  String
  discogsToken     String?
  currency         String   @default("USD")
  itemsPerPage     Int      @default(24)
  logoUrl          String?
  description      String?
  accentColor      String   @default("#2563eb")

  websiteUrl       String?
  instagramUrl     String?
  facebookUrl      String?
  bandcampUrl      String?

  // Presentation. Stores are browsed mostly on phones, so how the shop chooses
  // to lay itself out matters more than any single default we could pick.
  /** light | dark | sepia | monochrome | midnight | amoled */
  theme            String   @default("light")
  /** compact | banner. Compact keeps the masthead to one row. */
  headerStyle      String   @default("compact")
  /** grid | list | coverflow. The layout a customer sees first. */
  defaultLayout    String   @default("grid")
  /** carousel | grid | list */
  featuredLayout   String   @default("carousel")
  /** Wide image across the top of the storefront, used by the banner header. */
  bannerUrl        String?
  /** Longer "about the shop" copy, shown in the expandable section. The short
      `description` is what appears in search results and link previews. */
  aboutText        String?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  lastSyncAt       DateTime?
  // "running" | "success" | "error". Set to "running" when a background sync is
  // claimed, so a second sync can't start on top of one already in flight.
  lastSyncStatus   String?
  lastSyncError    String?
  // When the in-flight sync was claimed. Used to expire a "running" status left
  // behind by a process that died mid-sync.
  syncStartedAt    DateTime?

  items     InventoryItem[]
  locations StoreLocation[]

  @@index([discogsUsername])
}

/**
 * A shop can trade from more than one address, so locations are their own rows
 * rather than columns on Store. Everything is optional: an online-only shop
 * simply has none.
 */
model StoreLocation {
  id           String  @id @default(cuid())
  storeId      String
  store        Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)

  /** Shown as a heading when a shop has several, e.g. "Camden" or "Warehouse". */
  label        String?
  addressLine  String?
  city         String?
  postcode     String?
  country      String?
  phone        String?
  /** Free text, one line per day, so shops can write "Closed Mondays" and the
      like without fighting a structured form. */
  openingHours String?
  /** Controls display order; lowest first. */
  sortOrder    Int     @default(0)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([storeId, sortOrder])
}

model InventoryItem {
  id                 String   @id @default(cuid())
  storeId            String
  store              Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  listingId          BigInt
  releaseId          Int
  title              String
  artist             String
  label              String?
  catalogNumber      String?
  format             String?
  formatDescriptions String?
  genres             String?
  styles             String?
  year               Int?
  country            String?
  condition          String?
  sleeveCondition    String?
  price              Float?
  priceCurrency      String?
  comments           String?
  imageUrl           String?
  thumbUrl           String?
  discogsUri         String?
  releaseUri         String?
  status             String?
  searchText         String

  /**
   * Which generation of release data this item holds.
   *
   * The release lookup is the expensive part of a sync, so it only runs once
   * per item. When we start storing something new from a release (a pressing
   * country, say), already-looked-up items would otherwise never gain it and
   * the new filter would only work for shops that joined afterwards. Bumping
   * `DETAIL_VERSION` in `src/lib/item-image.ts` makes the background warm pick
   * those items back up, at its usual low priority.
   */
  detailVersion      Int      @default(0)

  isVisible          Boolean  @default(true)
  isFeatured         Boolean  @default(false)

  rawData            String?

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([storeId, listingId])
  @@index([storeId, isVisible])
  @@index([storeId, isFeatured])
  @@index([storeId, detailVersion])
}
